  BIA["Business impact analysis and workload criticality"] --> Objectives["Business-approved RTO / RPO / recovery level"]
  Objectives --> Pattern{"Select workload protection pattern"}
  Pattern --> Backup["Azure Backup: point-in-time recovery"]
  Pattern --> ASR["Azure Site Recovery: replication and failover"]
  Backup --> Vault["Vault architecture and anti-tampering controls"]
  ASR --> Vault
  Vault --> Plan["Recovery plan, sequencing and test drill"]
  Plan --> Evidence["Measured RTO / RPO and application validation"]
  Evidence --> Review["Remediation, sign-off and periodic review"]
