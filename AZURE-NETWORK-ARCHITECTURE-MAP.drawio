<mxfile host="app.diagrams.net" modified="2026-11-04T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="azure-network-map" name="Azure Network Architecture"><mxGraphModel dx="2600" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="AZURE NETWORK ARCHITECTURE MAP" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#102A43;fontStyle=1;fontSize=30;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="40" width="1800" height="70" as="geometry"/></mxCell><mxCell id="onprem" value="&lt;b&gt;ON-PREMISES&lt;/b&gt;&lt;br&gt;Corporate network&lt;br&gt;Datacenter / branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="330" height="145" as="geometry"/></mxCell><mxCell id="hybrid" value="&lt;b&gt;HYBRID CONNECTIVITY&lt;/b&gt;&lt;br&gt;ExpressRoute / VPN Gateway&lt;br&gt;BGP • redundant paths" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/C-networking-private-connectivity/expressroute/README.md"><mxGeometry x="480" y="230" width="390" height="145" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;CONNECTIVITY HUB VNET&lt;/b&gt;&lt;br&gt;Azure Firewall • central inspection&lt;br&gt;VPN / ExpressRoute Gateway&lt;br&gt;Bastion • DNS Resolver / forwarding&lt;br&gt;UDRs • shared network services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/C-networking-private-connectivity/README.md"><mxGeometry x="1000" y="180" width="590" height="260" as="geometry"/></mxCell><mxCell id="spokeapp" value="&lt;b&gt;APPLICATION SPOKE VNET&lt;/b&gt;&lt;br&gt;Web subnet • App subnet&lt;br&gt;NSGs / ASGs • workload segmentation&lt;br&gt;Internal Load Balancer (when needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/C-networking-private-connectivity/virtual-networks-vnet/README.md"><mxGeometry x="1780" y="110" width="610" height="230" as="geometry"/></mxCell><mxCell id="spokedata" value="&lt;b&gt;DATA SPOKE VNET&lt;/b&gt;&lt;br&gt;Private Endpoint subnet&lt;br&gt;Private Link to PaaS services&lt;br&gt;Private DNS zone integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/C-networking-private-connectivity/private-link-and-private-endpoints/README.md"><mxGeometry x="1780" y="410" width="610" height="230" as="geometry"/></mxCell><mxCell id="ingress" value="&lt;b&gt;NORTH-SOUTH INGRESS&lt;/b&gt;&lt;br&gt;Internet / users&lt;br&gt;Azure Front Door • global edge&lt;br&gt;Application Gateway + WAF • regional&lt;br&gt;Azure DNS • public name resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/D-traffic-management-delivery/azure-front-door/README.md"><mxGeometry x="70" y="690" width="500" height="235" as="geometry"/></mxCell><mxCell id="egress" value="&lt;b&gt;CONTROLLED EGRESS&lt;/b&gt;&lt;br&gt;Spoke UDR → Hub Firewall&lt;br&gt;Firewall policy / threat intelligence&lt;br&gt;NAT Gateway for selected direct egress&lt;br&gt;Validate SNAT + return route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/C-networking-private-connectivity/azure-firewall/README.md"><mxGeometry x="700" y="690" width="500" height="235" as="geometry"/></mxCell><mxCell id="private" value="&lt;b&gt;PRIVATE PaaS ACCESS&lt;/b&gt;&lt;br&gt;Private Endpoint NIC + private IP&lt;br&gt;Private DNS zone + VNet links&lt;br&gt;On-prem DNS forwarding / resolver&lt;br&gt;Disable public access where required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/C-networking-private-connectivity/private-dns-zones/README.md"><mxGeometry x="1330" y="690" width="500" height="235" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;OBSERVABILITY&lt;/b&gt;&lt;br&gt;Network Watcher&lt;br&gt;NSG / Firewall flow diagnostics&lt;br&gt;Connection troubleshoot • effective routes&lt;br&gt;Alerts • logs • change validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/D-traffic-management-delivery/network-watcher/README.md"><mxGeometry x="1960" y="690" width="430" height="235" as="geometry"/></mxCell><mxCell id="foundation" value="&lt;b&gt;ADDRESSING &amp;amp; SEGMENTATION&lt;/b&gt;&lt;br&gt;VNet address spaces • non-overlapping CIDRs&lt;br&gt;Subnet boundaries • reserved service subnets&lt;br&gt;NSGs = distributed L3/L4 filtering&lt;br&gt;ASGs = role-based VM grouping&lt;br&gt;Plan IPAM across regions / on-prem / cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/C-networking-private-connectivity/subnets-and-cidr-planning/README.md"><mxGeometry x="70" y="1120" width="700" height="280" as="geometry"/></mxCell><mxCell id="routing" value="&lt;b&gt;ROUTING &amp;amp; TRANSIT&lt;/b&gt;&lt;br&gt;VNet peering • non-transitive by default&lt;br&gt;UDRs • system routes • BGP propagation&lt;br&gt;Hub-and-spoke or Virtual WAN decision&lt;br&gt;Symmetric forward + return paths&lt;br&gt;Firewall insertion must be proven by routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/C-networking-private-connectivity/user-defined-routes-udrs/README.md"><mxGeometry x="950" y="1120" width="700" height="280" as="geometry"/></mxCell><mxCell id="principles" value="&lt;b&gt;ARCHITECTURE RULES&lt;/b&gt;&lt;br&gt;Network reachability ≠ authorization&lt;br&gt;Private Endpoint ≠ complete private access&lt;br&gt;Peering ≠ automatic hub inspection&lt;br&gt;ExpressRoute ≠ automatic encryption&lt;br&gt;Test DNS + routes + policy from client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=3;fontColor=#243B53;fontSize=17;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1" link="https://github.com/tripathies/azure-master-vault/blob/main/C-networking-private-connectivity/README.md"><mxGeometry x="1830" y="1120" width="560" height="280" as="geometry"/></mxCell><mxCell id="e_onprem_hybrid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0E7490;strokeWidth=7;endArrow=block;endFill=1;" edge="1" parent="1" source="onprem" target="hybrid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_hybrid_hub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0E7490;strokeWidth=7;endArrow=block;endFill=1;" edge="1" parent="1" source="hybrid" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_hub_spokeapp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=7;endArrow=block;endFill=1;" edge="1" parent="1" source="hub" target="spokeapp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_hub_spokedata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F766E;strokeWidth=7;endArrow=block;endFill=1;" edge="1" parent="1" source="hub" target="spokedata"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_ingress_spokeapp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="ingress" target="spokeapp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_spokeapp_egress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B45309;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="spokeapp" target="egress"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_spokedata_private" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F766E;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="spokedata" target="private"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_hub_ops" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="hub" target="ops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_foundation_hub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D4ED8;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="foundation" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_routing_hub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0369A1;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="routing" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_principles_hub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="principles" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Typical pattern only. Validate routing, gateway transit, DNS forwarding, endpoint policies, regional support and security requirements. Firewall inspection occurs only when routes actually steer traffic through it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;fontColor=#7C2D12;fontSize=16;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="1515" width="2320" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>