flowchart TB
  Repo["Git repository / pull request"] --> Validate["Format, lint, test and security scan"]
  Validate --> Pipeline["Azure DevOps Pipelines or GitHub Actions"]
  Pipeline --> Identity["OIDC / workload identity federation"]
  Identity --> Plan["Terraform plan or Bicep what-if"]
  Plan --> Review["Approval and controlled release"]
  Review --> Deploy["Deploy and verify Azure resources"]
  Estate["Existing on-premises / multicloud estate"] --> Discover["Discover and assess dependencies"]
  Discover --> Migrate["Azure Migrate: migration waves and cutover"]
  Estate --> Arc["Azure Arc: hybrid inventory, policy and management"]
  Migrate --> Target["Azure landing zone / modernized workload"]
  Arc --> Control["Govern and operate supported hybrid resources"]
  Deploy --> Observe["Post-deployment checks and drift management"]
